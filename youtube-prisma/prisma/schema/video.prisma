model Video {
  id String @id @default(cuid())

  title       String
  description String

  thumbnail String
  video     String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_map")

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id])

  likes    Like[]
  comments Comment[]

  @@map("videos")
}
